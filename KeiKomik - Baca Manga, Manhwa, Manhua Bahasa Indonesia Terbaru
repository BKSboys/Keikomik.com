}

.ql-editor table { border-collapse: collapse; }

.ql-editor td { border: 1px solid rgb(0, 0, 0); padding: 2px 5px; }

.ql-editor ol { padding-left: 1.5em; }

.ql-editor li { list-style-type: none; padding-left: 1.5em; position: relative; }

.ql-editor li > .ql-ui::before { display: inline-block; margin-left: -1.5em; margin-right: 0.3em; text-align: right; white-space: nowrap; width: 1.2em; }

